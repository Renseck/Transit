@inherits LayoutComponentBase

<MudThemeProvider Theme="TransitTheme.Instance" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0">
        <div class="tr-brand">
            <span class="tr-brand__bullet"></span>
            <span class="tr-brand__word">Transit</span>
        </div>
        <MudSpacer />
        <span class="tr-rail__tag">commute-km declaration</span>
    </MudAppBar>
    <MudDrawer Open="true" Elevation="0" Variant="@DrawerVariant.Persistent">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>