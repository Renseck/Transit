@page "/template"
@rendermode InteractiveServer
@using System.Text
@using ClosedXML.Excel
@using Transit.Core.Abstractions
@using Transit.Core.Entities
@inject ITemplateProfileStore Profiles
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Template</PageTitle>

<div class="tr-stack">
    <header class="tr-board">
        <div>
            <div class="tr-board__eyebrow">Template</div>
            <h1 class="tr-board__month">Configuration</h1>
        </div>
        <nav class="tr-board__nav">
            <label class="tr-ctrl tr-ctrl--now" style="cursor:pointer;">
                + Upload template
                <InputFile OnChange="OnUpload" accept=".xlsx" style="display:none;" />
            </label>
        </nav>
    </header>

    @if (_profiles.Count > 0)
    {
        <div class="tr-line-list tr-tpl-list">
            @foreach (var p in _profiles)
            {
                var isLoaded = _profile?.Id == p.Id;
                <div class="tr-line-row tr-line-row--clickable @(isLoaded ? "tr-line-row--current" : "")"
                     role="button" tabindex="0" @onclick="() => SelectProfile(p)">
                    <span class="tr-run__period">@p.Name</span>
                    @if (p.IsActive)
                    {
                        <span class="tr-tag tr-chip--default">Active</span>
                    }
                    <span class="tr-line-row__spacer"></span>
                    <span class="tr-line-row__actions" @onclick:stopPropagation="true">
                        @if (!p.IsActive)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small"
                                           title="Set active" OnClick="() => SetActive(p)" />
                        }
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       title="Rename" OnClick="() => Rename(p)" />
                        @if (!p.IsActive)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                           title="Delete" OnClick="() => Delete(p)" />
                        }
                    </span>
                </div>
            }
        </div>
    }

    @if (_profile is null)
    {
        <p class="tr-note">
            <span class="tr-note__key">Empty</span>
            <span>Upload the employer's .xlsx template, then map its columns and header cells.</span>
        </p>
    }
    else
    {
        <div class="tr-map-grid">
            <div class="tr-stack" style="gap:1rem;">
                <div class="tr-section-eyebrow">Sheet</div>
                <MudSelect T="string" @bind-Value="_sheetSelector" Label="Sheet" Variant="Variant.Outlined" Dense="true">
                    @foreach (var name in _sheetNames)
                    {
                        <MudSelectItem T="string" Value="name">@name</MudSelectItem>
                    }
                </MudSelect>
                <div style="display:flex; gap:0.75rem;">
                    <MudNumericField T="int" @bind-Value="_dataStartRow" Label="Data start row" Variant="Variant.Outlined" Min="1" />
                    <MudNumericField T="int" @bind-Value="_dataRowCount" Label="Data rows" Variant="Variant.Outlined" Min="1" />
                </div>

                <div class="tr-section-eyebrow">Columns</div>
                <div class="tr-map-rows">
                    <div class="tr-map-row">
                        <span class="tr-map-row__head">Field</span>
                        <span class="tr-map-row__head">Col</span>
                        <span class="tr-map-row__head">Format</span>
                        <span></span>
                    </div>
                    @foreach (var col in _columns)
                    {
                        <div class="tr-map-row">
                            <MudSelect T="TemplateColumnField" @bind-Value="col.Field" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                @foreach (var f in Enum.GetValues<TemplateColumnField>())
                                {
                                    <MudSelectItem T="TemplateColumnField" Value="f">@f</MudSelectItem>
                                }
                            </MudSelect>
                            <MudTextField @bind-Value="col.Column" Placeholder="A" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudTextField @bind-Value="col.Format" Placeholder="0.0" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" title="Remove" OnClick="() => _columns.Remove(col)" />
                        </div>
                    }
                </div>
                <button type="button" class="tr-map-add" @onclick="AddColumn">+ Column mapping</button>

                <div class="tr-section-eyebrow">Header cells</div>
                <div class="tr-map-rows">
                    <div class="tr-map-row">
                        <span class="tr-map-row__head">Source</span>
                        <span class="tr-map-row__head">Cell</span>
                        <span class="tr-map-row__head">Value</span>
                        <span></span>
                    </div>
                    @foreach (var cell in _cells)
                    {
                        <div class="tr-map-row">
                            <MudSelect T="TemplateCellSource" @bind-Value="cell.Source" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                @foreach (var s in Enum.GetValues<TemplateCellSource>())
                                {
                                    <MudSelectItem T="TemplateCellSource" Value="s">@s</MudSelectItem>
                                }
                            </MudSelect>
                            <MudTextField @bind-Value="cell.CellRef" Placeholder="C5" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudTextField @bind-Value="cell.Value" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" title="Remove" OnClick="() => _cells.Remove(cell)" />
                        </div>
                    }
                </div>
                <button type="button" class="tr-map-add" @onclick="AddCell">+ Cell mapping</button>

                <div class="tr-board__nav" style="margin-top:0.5rem;">
                    <button type="button" class="tr-ctrl tr-ctrl--now" @onclick="SaveMappings">Save</button>
                    @if (!_profile.IsActive)
                    {
                        <button type="button" class="tr-ctrl tr-ctrl--line" @onclick="() => SetActive(_profile)">Set active</button>
                    }
                    else
                    {
                        <span class="tr-tag tr-chip--default">Active</span>
                    }
                </div>
            </div>

            <div>
                <div class="tr-section-eyebrow">Sheet preview</div>
                <div class="tr-sheet-preview">
                    <table>
                        <thead>
                            <tr>
                                <th></th>
                                @foreach (var letter in _previewColumns)
                                {
                                    <th>@letter</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @for (var r = 0; r < _preview.Count; r++)
                            {
                                var rowNum = r + 1;
                                <tr>
                                    <th>@rowNum</th>
                                    @for (var c = 0; c < _previewColumns.Count; c++)
                                    {
                                        var letter = _previewColumns[c];
                                        <td class="@(IsTarget(letter, rowNum) ? "tr-cell--target" : "")">@_preview[r][c]</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private const int PreviewRows = 12;
    private const int PreviewCols = 7;   // A..G

    private TemplateProfile? _profile;
    private List<TemplateProfile> _profiles = [];
    private string _sheetSelector = "";
    private int _dataStartRow = 1;
    private int _dataRowCount = 1;
    private readonly List<ColumnMapping> _columns = [];
    private readonly List<CellMapping> _cells = [];

    private List<string> _sheetNames = [];
    private List<string> _previewColumns = [];
    private readonly List<List<string>> _preview = [];

    protected override async Task OnInitializedAsync()
    {
        await ReloadProfilesAsync();
        _profile = _profiles.FirstOrDefault(p => p.IsActive) ?? _profiles.FirstOrDefault();
        if (_profile is not null)
        {
            await LoadProfileAsync(_profile);
        }
    }

    private async Task ReloadProfilesAsync()
    {
        _profiles = [.. await Profiles.GetAllAsync()];
    }

    private async Task OnUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        try
        {
            using var buffer = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024).CopyToAsync(buffer);
            buffer.Position = 0;

            var (firstSheet, _) = ReadSheetNames(buffer);
            buffer.Position = 0;

            var profile = new TemplateProfile
            {
                Name = file.Name,
                TemplateFilePath = "",
                SheetSelector = firstSheet,
                DataStartRow = 1,
                DataRowCount = 1,
            };
            _profile = await Profiles.CreateAsync(profile, buffer);
            await LoadProfileAsync(_profile);
            Snackbar.Add("Template uploaded. Map the columns, then set it active.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Upload failed: {ex.Message}", Severity.Warning);
        }
    }

    private async Task LoadProfileAsync(TemplateProfile profile)
    {
        _sheetSelector = profile.SheetSelector;
        _dataStartRow = Math.Max(1, profile.DataStartRow);
        _dataRowCount = Math.Max(1, profile.DataRowCount);
        _columns.Clear();
        _columns.AddRange(profile.ColumnMappings.Select(c => new ColumnMapping { Field = c.Field, Column = c.Column, Format = c.Format }));
        _cells.Clear();
        _cells.AddRange(profile.CellMappings.Select(c => new CellMapping { CellRef = c.CellRef, Source = c.Source, Value = c.Value, Format = c.Format }));

        await using var stream = await Profiles.OpenTemplateAsync(profile.Id);
        BuildPreview(stream);
    }

    private static (string first, List<string> all) ReadSheetNames(Stream xlsx)
    {
        using var wb = new XLWorkbook(xlsx);
        var names = wb.Worksheets.Select(w => w.Name).ToList();
        return (names.FirstOrDefault() ?? "Sheet1", names);
    }

    private void BuildPreview(Stream xlsx)
    {
        _preview.Clear();
        _previewColumns = [.. Enumerable.Range(0, PreviewCols).Select(ColumnLetter)];

        using var wb = new XLWorkbook(xlsx);
        _sheetNames = wb.Worksheets.Select(w => w.Name).ToList();
        var sheet = wb.Worksheets.FirstOrDefault(w => w.Name == _sheetSelector) ?? wb.Worksheet(1);

        for (var r = 1; r <= PreviewRows; r++)
        {
            var cells = new List<string>();
            for (var c = 1; c <= PreviewCols; c++)
            {
                cells.Add(sheet.Cell(r, c).GetString());
            }
            _preview.Add(cells);
        }
    }

    private static string ColumnLetter(int zeroBased) => ((char)('A' + zeroBased)).ToString();

    private bool IsTarget(string columnLetter, int rowNumber)
    {
        var inDataBand = rowNumber >= _dataStartRow && rowNumber < _dataStartRow + _dataRowCount;
        if (inDataBand && _columns.Any(c => string.Equals(c.Column, columnLetter, StringComparison.OrdinalIgnoreCase)))
        {
            return true;
        }

        var cellRef = $"{columnLetter}{rowNumber}";
        return _cells.Any(c => string.Equals(c.CellRef, cellRef, StringComparison.OrdinalIgnoreCase));
    }

    private void AddColumn() => _columns.Add(new ColumnMapping { Field = TemplateColumnField.Date, Column = "A" });
    private void AddCell() => _cells.Add(new CellMapping { CellRef = "A1", Source = TemplateCellSource.MonthName });

    private async Task SaveMappings()
    {
        if (_profile is null)
        {
            return;
        }

        try
        {
            await Profiles.UpdateMappingsAsync(_profile.Id, _columns, _cells, _sheetSelector, _dataStartRow, _dataRowCount);
            Snackbar.Add("Mappings saved.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Warning);
        }
    }

    private async Task SelectProfile(TemplateProfile p)
    {
        _profile = p;
        await LoadProfileAsync(p);
    }

    private async Task SetActive(TemplateProfile p)
    {
        await Profiles.SetActiveAsync(p.Id);
        await ReloadProfilesAsync();
        _profile = _profiles.FirstOrDefault(x => x.Id == p.Id) ?? _profile;
        Snackbar.Add("Template set active.", Severity.Success);
    }

    private async Task Rename(TemplateProfile p)
    {
        var parameters = new DialogParameters<RenameDialog>
        {
            { x => x.InitialName, p.Name },
        };
        var dialog = await DialogService.ShowAsync<RenameDialog>("Rename template", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not string newName)
        {
            return;
        }

        try
        {
            await Profiles.RenameAsync(p.Id, newName);
            await ReloadProfilesAsync();
            _profile = _profiles.FirstOrDefault(x => x.Id == p.Id) ?? _profile;
            Snackbar.Add("Template renamed.", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    private async Task Delete(TemplateProfile p)
    {
        var parameters = new DialogParameters<MudMessageBox>
        {
            { x => x.Title, "Delete template" },
            { x => x.Message, $"Delete \"{p.Name}\"? Its stored file and mappings are removed. This cannot be undone." },
            { x => x.YesText, "Delete" },
            { x => x.CancelText, "Cancel" },
        };
        var dialog = await DialogService.ShowAsync<MudMessageBox>(string.Empty, parameters);
        var result = await dialog.Result;
        var confirmed = result is not null && !result.Canceled && result.Data as bool? == true;
        if (confirmed != true)
        {
            return;
        }

        await Profiles.DeleteAsync(p.Id);
        await ReloadProfilesAsync();
        if (_profile?.Id == p.Id)
        {
            _profile = _profiles.FirstOrDefault(x => x.IsActive) ?? _profiles.FirstOrDefault();
            if (_profile is not null)
            {
                await LoadProfileAsync(_profile);
            }
        }
        Snackbar.Add("Template deleted.", Severity.Normal);
    }
}