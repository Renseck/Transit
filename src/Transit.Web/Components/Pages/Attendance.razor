@page "/attendance"
@rendermode InteractiveServer
@using Transit.Core.Abstractions
@using Transit.Core.Calendar
@using Transit.Core.Declarations
@using Transit.Core.Entities
@using Transit.Core.Services
@inject LocationService Locations
@inject IAttendanceStore AttendanceStore
@inject RouteService Routes

<PageTitle>Attendance</PageTitle>

<div class="tr-stack">
    <header class="tr-board">
        <div>
            <div class="tr-board__eyebrow">Period</div>
            <h1 class="tr-board__month">@_monthLabel</h1>
            <TravelKmCounter Summary="CounterSummary()" />
        </div>
        <nav class="tr-board__nav" aria-label="Change month">
            <button type="button" class="tr-ctrl" @onclick="PrevMonth" aria-label="Previous month">‹ Prev</button>
            <button type="button" class="tr-ctrl tr-ctrl--now" @onclick="GoToday">Today</button>
            <button type="button" class="tr-ctrl" @onclick="NextMonth" aria-label="Next month">Next ›</button>
        </nav>
    </header>

    <div class="tr-brush-bar" role="radiogroup" aria-label="Active location">
        <span class="tr-brush-bar__label">Brush</span>
        <div class="tr-brush-set">
            @foreach (var loc in _locations)
            {
                <button type="button"
                        class="tr-brush"
                        style="--line:@loc.ColorHex"
                        aria-pressed="@Pressed(_brushSelected && _activeLocationId == loc.Id)"
                        @onclick="() => OnBrushChanged(loc.Id)">
                    <span class="tr-bullet @(loc.CountsAsTravel ? "" : "tr-bullet--outline")"
                          style="--bullet-color:@loc.ColorHex;--bullet-fg:@ContrastText(loc.ColorHex)">@Initial(loc)</span>
                    <span class="tr-brush__name">@loc.Name</span>
                </button>
            }
            <button type="button"
                    class="tr-brush tr-brush--erase"
                    aria-pressed="@Pressed(_brushSelected && _activeLocationId is null)"
                    @onclick="OnEraserChosen">
                <span class="tr-bullet tr-bullet--erase">⌫</span>
                <span class="tr-brush__name">Erase</span>
            </button>
        </div>
    </div>

    <section aria-label="Attendance calendar">
        <div class="tr-cal-head">
            @for (var i = 0; i < _weekdayHeaders.Length; i++)
            {
                var weekend = i >= 5;
                <div class="tr-cal-head__cell @(weekend ? "tr-cal-head__cell--weekend" : "")">@_weekdayHeaders[i]</div>
            }
        </div>
        <div class="tr-cal-grid" @onpointerup="EndStroke" @onpointerleave="EndStroke">
            @foreach (var week in _grid.Weeks)
            {
                @foreach (var day in week)
                {
                    var marked = LocationFor(day.Date);
                    <button type="button"
                            class="@DayClasses(day, marked)"
                            style="@DayVars(marked)"
                            aria-label="@DayLabel(day, marked)"
                            @onpointerdown="() => StartStroke(day)"
                            @onpointerenter="() => ContinueStroke(day)">
                        <span class="tr-day__num">@day.Date.Day</span>
                        <span class="tr-day__mark">
                            @if (marked is not null)
                            {
                                <span class="tr-bullet @(marked.CountsAsTravel ? "" : "tr-bullet--outline")"
                                      style="--bullet-color:@marked.ColorHex;--bullet-fg:@ContrastText(marked.ColorHex)">@Initial(marked)</span>
                            }
                        </span>
                    </button>
                }
            }
        </div>
    </section>

    <p class="tr-note">
        <span class="tr-note__key">Note</span>
        <span>
            Unmarked weekdays are treated as the default location (Home) at generation time, and can be
            overridden later in the review grid.
        </span>
    </p>
</div>

@code {
    private static readonly string[] _weekdayHeaders = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

    private List<WorkLocation> _locations = [];
    private List<Route> _routes = [];
    private int? _activeLocationId;   // null = eraser
    private bool _brushSelected;      // false = nothing chosen; distinguishes from eraser
    private bool _painting;           // true while a pointer stroke is in progress
    private List<WorkLocation> _allLocations = []; // includes archived, for rendering marks
    private int _year = DateTime.Today.Year;
    private int _month = DateTime.Today.Month;
    private MonthGrid _grid = MonthGridBuilder.Build(DateTime.Today.Year, DateTime.Today.Month);
    private Dictionary<DateOnly, int> _marks = [];

    private string _monthLabel => new DateOnly(_year, _month, 1).ToString("MMMM yyyy");

    protected override async Task OnInitializedAsync()
    {
        _allLocations = [.. await Locations.GetAllAsync(includeArchived: true)];
        _routes = [.. await Routes.GetAllAsync()];
        _locations = [.. _allLocations.Where(l => !l.IsArchived)];
        if (_locations.Count > 0)
        {
            _activeLocationId = _locations[0].Id;
            _brushSelected = true;
        }

        await LoadMonthAsync();
    }

    private async Task LoadMonthAsync()
    {
        _grid = MonthGridBuilder.Build(_year, _month);
        var from = _grid.Weeks[0][0].Date;
        var to = _grid.Weeks[^1][^1].Date;
        var entries = await AttendanceStore.GetRangeAsync(from, to);
        _marks = entries.ToDictionary(e => e.Date, e => e.WorkLocationId);
    }

    private void OnBrushChanged(int id)
    {
        _activeLocationId = id;
        _brushSelected = true;
    }

    private void OnEraserChosen()
    {
        _activeLocationId = null;
        _brushSelected = true;
    }

    // A pointer press begins a stroke and applies the click (toggle) outcome to this day.
    private async Task StartStroke(CalendarDay day)
    {
        if (!_brushSelected)
        {
            return;
        }

        _painting = true;
        await ApplyOutcome(day.Date, BrushResolver.ResolveClick(CurrentMark(day.Date), _activeLocationId));
    }

    // A day entered while the pointer is down paints/erases without toggle semantics.
    private async Task ContinueStroke(CalendarDay day)
    {
        if (!_painting || !_brushSelected)
        {
            return;
        }

        await ApplyOutcome(day.Date, BrushResolver.ResolveDrag(CurrentMark(day.Date), _activeLocationId));
    }

    private void EndStroke() => _painting = false;

    private int? CurrentMark(DateOnly date) => _marks.TryGetValue(date, out var id) ? id : null;

    private async Task ApplyOutcome(DateOnly date, BrushOutcome outcome)
    {
        if (outcome == BrushOutcome.NoOp)
        {
            return;
        }

        if (outcome == BrushOutcome.Clear)
        {
            await AttendanceStore.ClearAsync(date);
            _marks.Remove(date);
            return;
        }

        // Set: _activeLocationId is guaranteed non-null here (eraser only yields Clear/NoOp).
        var locationId = _activeLocationId!.Value;
        await AttendanceStore.SetAsync(date, locationId);
        _marks[date] = locationId;
    }

    private async Task PrevMonth()
    {
        var d = new DateOnly(_year, _month, 1).AddMonths(-1);
        (_year, _month) = (d.Year, d.Month);
        await LoadMonthAsync();
    }

    private async Task NextMonth()
    {
        var d = new DateOnly(_year, _month, 1).AddMonths(1);
        (_year, _month) = (d.Year, d.Month);
        await LoadMonthAsync();
    }

    private async Task GoToday()
    {
        (_year, _month) = (DateTime.Today.Year, DateTime.Today.Month);
        await LoadMonthAsync();
    }

    private WorkLocation? LocationFor(DateOnly date)
        => _marks.TryGetValue(date, out var id) ? _allLocations.FirstOrDefault(l => l.Id == id) : null;

    private static string Initial(WorkLocation loc)
        => string.IsNullOrEmpty(loc.Name) ? "?" : loc.Name[..1].ToUpperInvariant();

    private static string Pressed(bool value) => value.ToString().ToLowerInvariant();

    private string DayClasses(CalendarDay day, WorkLocation? marked)
    {
        var classes = new List<string> { "tr-day" };
        if (marked is not null)
        {
            classes.Add("tr-day--marked");
            if (marked.IsArchived)
            {
                classes.Add("tr-day--archived-mark");
            }
        }
        if (day.Date.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday)
        {
            classes.Add("tr-day--weekend");
        }
        if (!day.InCurrentMonth)
        {
            classes.Add("tr-day--outside");
        }
        if (day.Date == DateOnly.FromDateTime(DateTime.Today))
        {
            classes.Add("tr-day--today");
        }
        return string.Join(' ', classes);
    }

    private static string DayVars(WorkLocation? marked)
        => marked is not null ? $"--line:{marked.ColorHex}" : string.Empty;

    private string DayLabel(CalendarDay day, WorkLocation? marked)
    {
        var date = day.Date.ToString("dddd d MMMM");
        if (marked is null)
        {
            return $"{date} — unmarked";
        }

        return marked.IsArchived ? $"{date} — {marked.Name} (archived)" : $"{date} — {marked.Name}";
    }

    // Pick a legible glyph colour for a bullet against an arbitrary line colour.
    private static string ContrastText(string hex)
    {
        if (!TryParseHex(hex, out var r, out var g, out var b))
        {
            return "#FFFFFF";
        }

        // Relative luminance (sRGB, simple coefficients) — dark ink on light lines.
        var luminance = ((0.299 * r) + (0.587 * g) + (0.114 * b)) / 255.0;
        return luminance > 0.6 ? "#1A1F2B" : "#FFFFFF";
    }

    private static bool TryParseHex(string hex, out int r, out int g, out int b)
    {
        r = g = b = 0;
        var value = hex.TrimStart('#');
        if (value.Length != 6)
        {
            return false;
        }

        return int.TryParse(value.AsSpan(0, 2), System.Globalization.NumberStyles.HexNumber, null, out r)
            && int.TryParse(value.AsSpan(2, 2), System.Globalization.NumberStyles.HexNumber, null, out g)
            && int.TryParse(value.AsSpan(4, 2), System.Globalization.NumberStyles.HexNumber, null, out b);
    }

    private TravelKmSummary CounterSummary()
        => TravelKmCalculator.ForMarks(_marks, _year, _month, _allLocations, _routes);
}
